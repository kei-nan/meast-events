# Copy this to .env (gitignored - never commit real credentials) for local
# overrides. Both scripts/load-redis.js and server/index.js read REDIS_URL
# directly from the process environment - this file is just a convenience so
# you don't have to `export` it by hand every session; `npm start`/`npm run
# dev` below already load it automatically if present.

# Local Docker default - this is what's used if REDIS_URL is unset entirely,
# so you don't strictly need this file just to run against local Docker.
REDIS_URL=redis://localhost:6379

# Once you create a real Redis Cloud database (see ../server/README.md),
# paste its connection string here instead:
# REDIS_URL=redis://default:<password>@<host>.cloud.redislabs.com:<port>

PORT=3001
