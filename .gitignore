node_modules/
dist/
.vite/

# Secrets - server/.env would hold a real Redis connection string (with
# password) once someone points this at a real Redis Cloud instance.
# app/.env is intentionally NOT covered by this - it only holds a public
# default API URL, not a secret, and is meant to be committed.
server/.env
.env.local

# wrangler's local dev state (miniflare SQLite caches, bundled temp output)
# and its equivalent of a real Redis Cloud connection string.
worker/.wrangler/
worker/.dev.vars

# Large raw source dump for boundary data - regenerate via scripts/ingest-boundaries.js
# after downloading https://icr.ethz.ch/data/cshapes/CShapes-2.0.geojson into data/raw/
data/raw/

# Output of `wrangler deploy --dry-run --outdir=.dry-run` (worker/, CI)
.dry-run/
