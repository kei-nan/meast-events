node_modules/
dist/

# Generated from data/ by app/scripts/split-data.mjs on every dev start and build
# (including Cloudflare's), so it is not committed.
app/public/data/
# Full-text search index, built from data/ by app/scripts/build-search-index.mjs
# on every dev start and build.
app/public/pagefind/
# Names the content-hashed events/all.<hash>.json; rewritten by
# app/scripts/split-data.mjs on every dev start and build.
app/src/lib/dataVersion.js
.vite/

# Secrets. server/.env and worker/.dev.vars held the Redis connection string
# (with password) for the retired API; server/ and worker/ were removed, but
# old local copies may still exist, so they stay ignored (see DEPLOYMENT.md,
# "Retiring the old API").
server/.env
worker/.dev.vars
.env.local

# wrangler's local dev state (miniflare SQLite caches, bundled temp output).
app/.wrangler/
worker/.wrangler/

# Large raw source dump for boundary data - regenerate via scripts/ingest-boundaries.js
# after downloading https://icr.ethz.ch/data/cshapes/CShapes-2.0.geojson into data/raw/
data/raw/

# Output of `wrangler deploy --dry-run --outdir=.dry-run`
.dry-run/

.claude/

# Local scratch: throw-away wrangler configs / Playwright scripts / dev-server logs
.scratch/
*.log
