# https://editorconfig.org - matches the existing files: 2-space indents, LF
# line endings (see .gitattributes), UTF-8, final newline. JS uses double
# quotes and semicolons (not expressible here; keep to the surrounding code).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Markdown: a trailing double space is a line break.
[*.md]
trim_trailing_whitespace = false
