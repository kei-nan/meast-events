# Copy to worker/.dev.vars (gitignored) for `wrangler dev`. This file is only
# read locally by wrangler dev; it is never uploaded by `wrangler deploy`.
# In production REDIS_URL is a secret: `npx wrangler secret put REDIS_URL`.

# Local Docker default (redis/redis-stack-server on :6379).
REDIS_URL=redis://localhost:6379

# Optional: comma-separated exact CORS origins (scheme + host[:port], no
# trailing slash). Unset/blank = built-in defaults (production frontend +
# localhost:5173/4173/8794), NOT open. "*" opens it to every origin.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
