{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlaswiki-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  // Required: src/resp.js opens the Redis connection via `cloudflare:sockets`,
  // and the Node-compat flag is what the bundle was verified with.
  "compatibility_flags": ["nodejs_compat"],

  // Keeps the default https://<name>.<account-subdomain>.workers.dev URL,
  // which is the URL the frontend's VITE_API_URL points at.
  "workers_dev": true,

  // Persist request logs / exceptions in the dashboard (Workers Logs) so
  // Redis-unreachable (502/503) and CPU-limit (1102) failures can be diagnosed
  // after the fact. Free plan has a daily log-event cap; fine for this app.
  "observability": { "enabled": true },

  // REDIS_URL is deliberately NOT declared here. It contains a password, so it
  // must be a secret:   npx wrangler secret put REDIS_URL
  // (Do not put it in "vars": vars are plaintext, committed, and re-applied on
  // every `wrangler deploy` - a var with the same name as a secret makes
  // `wrangler secret put` fail and would overwrite the dashboard value on
  // each deploy.) For local dev, copy .dev.vars.example to .dev.vars.
  //
  // Non-secret settings go here.
  //
  // CORS: ALLOWED_ORIGINS is a comma-separated list of exact origins (scheme +
  // host[:port], no trailing slash) that browsers may read the API from. When
  // unset/blank the built-in default applies (src/logic.js
  // DEFAULT_ALLOWED_ORIGINS: https://middleeast.events,
  // https://atlas-wiki.middle-wiki.workers.dev plus
  // localhost dev origins). "*" opens it to every origin. CORS is browser-only;
  // it does not stop curl/bots or protect the request quota (docs/SECURITY.md).
  // Uncomment to override (e.g. after adding a custom domain):
  //
  // "vars": { "ALLOWED_ORIGINS": "https://middleeast.events,https://atlas-wiki.middle-wiki.workers.dev" },

  // Per-client rate limit (Workers Rate Limiting binding, Wrangler >= 4.36).
  // Counters are per Cloudflare location and eventually consistent - a brake on
  // hammering, not an accurate quota. Keyed by client IP in src/index.js.
  // Absent binding (local dev, tests) = no binding limit, code still works.
  // A limited request still counts toward the 100K/day Workers quota.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
