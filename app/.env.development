# Dev-only default: Vite loads .env.development for 'vite'/npm run dev, never for
# 'vite build'. Points at the local API server (see ../server).
# Production builds get no API URL unless the host sets VITE_API_URL; without it
# the app runs in pure static mode with the built-in dataset.
VITE_API_URL=http://localhost:3001
