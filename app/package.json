{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "split-data": "node scripts/split-data.mjs",
    "predev": "node scripts/split-data.mjs && node scripts/subset-fonts.mjs && node scripts/build-search-index.mjs",
    "prebuild": "npm test && node ../scripts/validate-events.js ../data/events.json && node scripts/split-data.mjs && node scripts/subset-fonts.mjs && node scripts/build-search-index.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/build-event-pages.mjs && node scripts/build-ai-files.mjs && node scripts/expand-headers.mjs && node scripts/check-dist.mjs",
    "prelint": "node scripts/split-data.mjs",
    "lint": "oxlint --deny-warnings",
    "test": "node --test \"src/lib/*.test.js\" \"src/components/*.test.js\" \"src/hooks/*.test.js\" \"scripts/*.test.mjs\" \"worker/*.test.js\"",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fontaine": "^1.0.3",
    "oxlint": "^1.90.0",
    "pagefind": "1.6.0",
    "playwright-core": "^1.64.1",
    "subset-font": "^2.9.0",
    "topojson-server": "^3.0.1",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
