# Response headers for the static-assets Worker "meast-events" (app/wrangler.jsonc).
# Copied to dist/ by Vite; Workers parses it and does not serve it as an asset.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# Limits: 100 rules, 2,000 chars/line, ONE splat per URL pattern (a pattern with
# two splats is silently ignored). All matching rules are merged; a header
# repeated across rules is comma-joined unless the later rule detaches it first
# with "! Header-Name" (used below to REPLACE Cache-Control rather than append).
#
# Cloudflare Web Analytics (enabled in the dashboard) injects a beacon script
# from static.cloudflareinsights.com that reports to cloudflareinsights.com.
#
# If you add an API/custom domain, update connect-src below - the CSP is an
# allow-list and a blocked request only shows up as a console violation.

# --- every response ---------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# --- caching ----------------------------------------------------------------
# /assets/*: Vite content-hashes everything EXCEPT the two MapLibre files
# (vite.config.js UNHASHED_ASSET_NAMES: maplibre-gl-worker.mjs and
# maplibre-gl-shared.mjs, whose names the worker imports at runtime). Those live
# in assets/maplibre-gl-<version>/, so the folder name is their cache key and a
# MapLibre upgrade gets a new URL. The default here is a short revalidating
# cache; hashed names and the versioned MapLibre folder opt in to immutable.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/index-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The lazy-loaded map chunk (App.jsx), content-hashed like index-*.
/assets/MapView-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted web fonts (src/main.jsx), content-hashed by Vite.
/assets/inter-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/spectral-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/maplibre-gl-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# /glyphs/*: map label glyphs (Open Sans Semibold, MapView.jsx BASE_STYLE).
# Static files that change only if the font does, so cache like /data/*.
/glyphs/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# /pagefind/*: the full-text search index (app/scripts/build-search-index.mjs).
# ids.json, the engine and the .pf_meta keep their names across data changes,
# and a stale ids.json would silently drop results for changed events, so they
# revalidate on every visit (a 304 when unchanged). The index chunks are named
# by content hash, so they are immutable.
/pagefind/*
  Cache-Control: public, no-cache

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# /event/*: the static per-event pages, the /event/ index and event.css
# (app/scripts/build-event-pages.mjs). Un-hashed HTML that changes with the data,
# so it revalidates on every visit like the home page (Cloudflare's default for
# HTML, set explicitly here).
/event/*
  Cache-Control: public, max-age=0, must-revalidate

# /data/*: the static dataset. Un-hashed names (events/1900.json, land.json ...)
# change on every data regeneration, so cache moderately and revalidate in the
# background: events/meta.json, ids.json, events/full/*.json, the
# decade chunks events/19xx.json, boundaries/*.json, land.json,
# selection-funnel.json. The ONE content-hashed data file is
# events/all.<12-hex-content-hash>.json (app/scripts/split-data.mjs): the hash
# in the name is the cache key, so it is immutable. If more hashed names are
# added, give them a distinctive prefix and add a rule like this one (a pattern
# may contain only one splat, so the match is "prefix.*").
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/events/all.*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
