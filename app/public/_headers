# Response headers for the static-assets Worker "meast-events" (app/wrangler.jsonc).
# Copied to dist/ by Vite; Workers parses it and does not serve it as an asset.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# Limits: 100 rules, 2,000 chars/line, ONE splat per URL pattern (a pattern with
# two splats is silently ignored). All matching rules are merged; a header
# repeated across rules is comma-joined unless the later rule detaches it first
# with "! Header-Name" (used below to REPLACE Cache-Control rather than append).
#
# Cloudflare Web Analytics (enabled in the dashboard) injects a beacon script
# from static.cloudflareinsights.com that reports to cloudflareinsights.com.
#
# If you add an API/custom domain, update connect-src below - the CSP is an
# allow-list and a blocked request only shows up as a console violation.

# The one inline script, index.html's first (it adds class "js" to <html>, so an
# event page's plain-HTML copy never flashes; src/index.css), is allowed by the
# 'sha256-...' source in script-src: the hash of its exact text. No other inline
# script runs ('unsafe-inline' stays out). scripts/check-dist.mjs fails the build
# if an inline script in dist/ has a hash this CSP does not list.
#
# --- every response ---------------------------------------------------------
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; child-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# --- caching ----------------------------------------------------------------
# Content-hashed files are immutable, but NOT through a splat rule: rules match the
# requested path, so a missing file's 404 (404.html, wrangler.jsonc) gets the
# headers of every rule matching it, and "/assets/* immutable" kept a 404 for a
# year (seen on the live site during a deploy). Each rule marked
# "#! immutable-per-file" below holds the header for a MISSING file (revalidate);
# scripts/expand-headers.mjs (npm run build) adds after it, in dist/_headers, an
# immutable rule per file (or per hashed folder) that exists. That counts toward
# the 100-rule limit; a marked rule that would not fit stays a splat (its files
# revalidate) and the build warns. scripts/check-dist.mjs checks the result.
#
# /assets/*: every file has a content-addressed URL, so all of it is immutable.
# Vite names emitted files <name>-<content hash>.<ext>, MapLibre's worker included.
# scripts/check-dist.mjs fails the build if any other file under dist/assets/
# lacks a hash, so an unhashed file can never get an immutable rule.
# No other rule matches /assets/, so nothing is comma-joined onto this
# Cache-Control (the /* rule above sets no Cache-Control).
#! immutable-per-file
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# The icons index.html and every page link (scripts/make-icons.mjs). Un-hashed
# names that change almost never, so cached for a day: with Cloudflare's default
# (revalidate on every use) Chromium asks for /favicon.svg and /favicon.ico again
# on each history.replaceState, which the app makes whenever the view in the URL
# changes (src/hooks/useUrlState.js). A changed icon reaches returning visitors within a day. Exact paths,
# not a splat, so a 404 for any other name is not cached. No other rule matches
# these paths, so nothing is comma-joined onto this Cache-Control.
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# /pagefind/*: the full-text search index (app/scripts/build-search-index.mjs).
# Everything Pagefind writes (engine, worker, wasm, entry, .pf_meta, index chunks)
# and ids.json lives in ONE versioned folder, pagefind/v.<12-hex-content-hash>/:
# the hash covers every file in it, so the whole folder is immutable (one rule
# for the build's folder, see above, like /data/events/v.*), a page never pairs
# an engine or index from two builds, and a Pagefind upgrade renames the folder.
# The splat holds for pagefind/meta.json (the one mutable file, naming the
# current folder) and for a request into another build's folder (a 404 that
# must not outlive the deploy): revalidate on every visit.
/pagefind/*
  Cache-Control: public, no-cache

#! immutable-per-file
/pagefind/v.*
  ! Cache-Control
  Cache-Control: public, no-cache

# /event/*: the per-event pages, the /event/ index and event.css
# (app/scripts/build-event-pages.mjs). Un-hashed HTML that changes with the data,
# so it revalidates on every visit like the home page (Cloudflare's default for
# HTML, set explicitly here). An event's page is the app (index.html filled in):
# like the home page it names the deploy's hashed /assets/, so it must never be
# served from a cache once those files are replaced.
/event/*
  Cache-Control: public, max-age=0, must-revalidate

# /data/*.tbin: the map's geometry, land and boundaries (land.tbin, land-far.tbin,
# land-cells/*.tbin, boundaries/v.<hash>/<decade>.tbin, boundaries/shared/<hash>.tbin), in
# the binary format of app/src/lib/geoCodec.js. Workers serves .tbin with no
# Content-Type, and Cloudflare only compresses responses whose type is on its
# list (application/octet-stream is not): without this the files ship raw (the
# opening view's land and 2020 borders: 177 KB instead of 83 KB with brotli,
# October 2026). The type is a label for the compressor; nothing reads it. It
# replaces the asset's own type (checked with wrangler dev), and the splat
# matches only .tbin files, so the JSON under /data/ keeps its type. Sets no
# Cache-Control: the /data/ rules below decide caching, as for the JSON files.
/data/*.tbin
  Content-Type: application/x-protobuf

# /data/*: the static dataset. Un-hashed names (land.tbin, land-far.tbin, land-cells/*.tbin, boundaries/meta.json,
# events/meta.json, selection-funnel.json, framing-review.json) change on every
# data regeneration, so cache moderately and revalidate in the background. All
# event data (the lite list and every full record) lives in ONE versioned folder,
# events/v.<12-hex-content-hash>/ (app/scripts/split-data.mjs): the hash covers
# every file in it and is the cache key, so the whole folder is immutable (one
# rule for the build's folder, see above) and a page never mixes two builds'
# files. A request into another build's folder (a page older or newer than the
# deploy) is a 404 that must not outlive the deploy, so the splat revalidates.
# If more hashed names are added, give them a distinctive prefix and add a
# marked rule like this one (a pattern may contain only one splat, which matches
# across "/", so the match is "prefix.*").
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

#! immutable-per-file
/data/events/v.*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# The border decade chunks live in ONE versioned folder too,
# boundaries/v.<12-hex hash of every chunk>/ (split-data.mjs splitBoundaries),
# named by the bundle and by boundaries/meta.json (the mutable file, revalidated
# above). A chunk names its shared geometry by content hash, so a new bundle
# never meets an older build's chunk pointing at a shared file the deploy
# removed. Immutable through one rule for the build's folder; another build's
# folder revalidates (the splat above).
#! immutable-per-file
/data/boundaries/v.*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Large boundary geometries stored once for several decades, named by a hash
# of their content (split-data.mjs splitBoundaries), so immutable too (a rule
# per file; a missing one revalidates).
#! immutable-per-file
/data/boundaries/shared/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# The raw border files carry their licence (CC BY-NC-SA 4.0 for the CShapes 2.0
# part, UN OCHA's non-commercial terms for the West Bank Areas A/B/C; data/LICENSE).
# The site does not serve that file, so the link is to the repository's copy.
# Adds only Link, which no other rule sets, so nothing is comma-joined onto it.
/data/boundaries/*
  Link: <https://github.com/kei-nan/meast-events/blob/main/data/LICENSE>; rel="license"
